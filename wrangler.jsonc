{
  "name": "twelve-studios",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIBERS",
      "id": "359722f26b6b4e89a93348987401ed79"
    }
  ]
}
